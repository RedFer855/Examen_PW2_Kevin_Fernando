{{!-- Parcial de bloque que envuelve cada página. Contexto: una entrada de contenido/diapositivas.js. --}}
<section
  class="diapositiva diapositiva--{{tono}} diapositiva--{{id}}"
  id="{{id}}"
  data-diapositiva
  data-mundo="{{mundo}}"
  data-tono="{{tono}}"
  aria-labelledby="{{id}}-titulo"
>
  <div class="diapositiva__interior">
    {{> @partial-block}}
  </div>
</section>
