{{!-- Botón de la demo. Sin `sitio.urlDemo` se ve igual pero no lleva href: no navega ni recibe foco. corto: etiqueta corta en pantallas chicas. --}}
<a
  class="boton boton--primario{{#if corto}} boton--compacto{{/if}}"
  {{#if @root.demo.disponible}}href="{{@root.demo.url}}"{{else}}role="link" aria-disabled="true"{{/if}}
  data-boton-demo
>
  <span class="boton__largo">{{@root.demo.probar}}</span>
  {{#if corto}}<span class="boton__corto" aria-hidden="true">{{@root.demo.probarCorto}}</span>{{/if}}
</a>
